# Template for .env (copy to .env, which is gitignored — never commit keys).
# Keep comments on their own lines; the loader takes values verbatim.
# The dry-run path (python -m rancor.run --dry-run) needs NONE of these.
#
# Two keys run everything.
#
# The five models under test route via OpenRouter
# (https://openrouter.ai/settings/keys).
OPENROUTER_API_KEY=

# The three judges pinned in judges.yaml run on Baseten's OpenAI-compatible
# model API (https://app.baseten.co/settings/api_keys). Judging fails without
# this; see api_key_env in judges.yaml.
BASETEN_API_KEY=

# Optional: direct provider keys, only if models.yaml is switched back to
# first-party routing.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
