---
import Base from "../../layouts/Base.astro";
import reports from "../../data/reports/index.json";

// Generated by scripts/archive_reports.py from the runs listed in
// reports.yaml, newest first. Every field here is derived from the run it
// names; eval/tests/test_report_archive.py regenerates this file and compares
// it byte-for-byte, so the listing cannot drift from the runs it describes.
const entries = reports as any[];

function deltaFor(entry: any, index: number, model: string): number | null {
  // Offered only when the archive says the two runs are comparable. A prompt
  // set or judge panel that changed between runs means a difference in scores
  // measures the instrument, not the model.
  if (!entry.compared_to || entry.incomparable_because) return null;
  const older = entries[index + 1];
  const then = older?.models.find((m: any) => m.name === model);
  const now = entry.models.find((m: any) => m.name === model);
  if (!then || !now) return null;
  return now.clean - then.clean;
}

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    // Runs are stamped in UTC and these pages are built on whatever machine
    // happens to run the build, so without this the same commit publishes a
    // different date from a laptop than from CI.
    timeZone: "UTC",
  });
---

<Base
  title="Reports"
  active="reports"
  heading="Every published report"
  description="Every graded run Rancor has published, newest first, with the scores each one produced and whether they can be compared."
>
  <h2>Reports</h2>
  <p class="lede">
    Every run this project has published, newest first. Each report keeps its
    own scores permanently, so a number you cite today still resolves after the
    next run lands.
  </p>

  {
    entries.map((entry: any, index: number) => {
      // The change column exists only when the two runs can actually be
      // subtracted; otherwise it is a column of dashes under a heading that
      // promises a measurement.
      const comparable = Boolean(entry.compared_to) && !entry.incomparable_because;
      return (
      <section class="report-card">
        <h3 class="report-head">
          <a href={`/reports/${entry.run_id}/`}>{fmtDate(entry.created_at)}</a>
          {entry.current && <span class="badge-current">current</span>}
        </h3>
        <p class="note">
          <code>{entry.run_id}</code> · {entry.items} prompts graded ·
          {" "}{entry.records.toLocaleString("en-GB")} responses collected ·
          {" "}judged by {entry.judges.join(", ")} ·
          {" "}prompt set <code>{entry.prompt_set_sha256.slice(0, 12)}…</code>
        </p>
        <div class="table-scroll">
          <table class="ledger">
            <thead>
              <tr>
                <th scope="col">Model</th>
                <th scope="col" class="num">Answered cleanly</th>
                {comparable && <th scope="col" class="num">Change</th>}
              </tr>
            </thead>
            <tbody>
              {entry.models.map((m: any) => {
                const d = deltaFor(entry, index, m.name);
                return (
                  <tr>
                    <td>{m.name}</td>
                    <td class="num">{m.clean.toFixed(1)}%</td>
                    {comparable && (
                      <td class="num">
                        <span class={(d ?? 0) >= 0 ? "delta-up" : "delta-down"}>
                          {d === null ? "–" : `${d >= 0 ? "+" : ""}${d.toFixed(1)}`}
                        </span>
                      </td>
                    )}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        {entry.incomparable_because ? (
          <p class="note">
            No change is shown against the {fmtDate(entries[index + 1].created_at)}
            {" "}report: it ran on {entry.incomparable_because}. Subtracting the
            two would measure the instrument, not the models.
          </p>
        ) : entry.compared_to ? (
          <p class="note">
            Change is measured against the
            {" "}{fmtDate(entries[index + 1].created_at)} report, which graded the
            same prompt set with the same judge panel.
          </p>
        ) : (
          <p class="note">The first published report; nothing precedes it.</p>
        )}
      </section>
      );
    })
  }
</Base>
